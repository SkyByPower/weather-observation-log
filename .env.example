# Осы файлды .env деп көшіріп, мәндерін өзгертіңіз.
# Кездейсоқ кілт жасау: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite (әдепкі, файл instance/ қалтасында жасалады). PostgreSQL үшін: postgresql+psycopg://user:password@localhost:5432/weather
DATABASE_URL=sqlite:///weather.db

# Жүктелетін файлдың ең үлкен көлемі (МБ)
MAX_UPLOAD_MB=5
